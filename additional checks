import java.security.SecureRandom;
import java.util.*;

public class PasswordGenerator {

    private static final String LOWERCASE = "abcdefghijklmnopqrstuvwxyz";
    private static final String UPPERCASE = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    private static final String DIGITS = "0123456789";
    private static final String SPECIAL_CHARACTERS = "!@#$%^&*()-_+=<>?/{}[]|:;,.";

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        
        // Ввод длины пароля с проверкой
        int length = getValidIntegerInput(scanner, "Enter password length (min 8): ", 8);

        // Выбор количества паролей
        int numPasswords = getValidIntegerInput(scanner, "How many passwords to generate? (min 1): ", 1);

        // Настройка параметров генерации пароля
        boolean includeLower = getYesOrNoInput(scanner, "Include lowercase letters? (y/n): ");
        boolean includeUpper = getYesOrNoInput(scanner, "Include uppercase letters? (y/n): ");
        boolean includeDigits = getYesOrNoInput(scanner, "Include digits? (y/n): ");
        boolean includeSpecial = getYesOrNoInput(scanner, "Include special characters? (y/n): ");

        // Проверка, что хотя бы одна категория символов выбрана
        if (!(includeLower || includeUpper || includeDigits || includeSpecial)) {
            System.out.println("Error: You must include at least one category of characters.");
            return;
        }

        // Генерация паролей
        System.out.println("\nGenerated Passwords:");
        for (int i = 1; i <= numPasswords; i++) {
            String password = generatePassword(length, includeLower, includeUpper, includeDigits, includeSpecial);
            System.out.println(i + ": " + password);
        }
    }

    // Получение ответа (y/n)
    private static boolean getYesOrNoInput(Scanner scanner, String prompt) {
        while (true) {
            System.out.print(prompt);
            String input = scanner.next().trim().toLowerCase();
            if (input.equals("y")) return true;
            if (input.equals("n")) return false;
            System.out.println("Invalid input. Please enter 'y' or 'n'.");
        }
    }

    // Получение корректного целого числа с минимальным значением
    private static int getValidIntegerInput(Scanner scanner, String prompt, int minValue) {
        int value;
        while (true) {
            System.out.print(prompt);
            if (scanner.hasNextInt()) {
                value = scanner.nextInt();
                if (value >= minValue) return value;
            } else {
                scanner.next(); // Очищаем неверный ввод
            }
            System.out.println("Invalid input. Please enter a number >= " + minValue);
        }
    }

    public static String generatePassword(int length, boolean includeLower, boolean includeUpper, boolean includeDigits, boolean includeSpecial) {
        StringBuilder characterSet = new StringBuilder();
        List<Character> password = new ArrayList<>();
        SecureRandom random = new SecureRandom();

        // Добавляем гарантированные символы для каждой выбранной категории
        if (includeLower) password.add(LOWERCASE.charAt(random.nextInt(LOWERCASE.length())));
        if (includeUpper) password.add(UPPERCASE.charAt(random.nextInt(UPPERCASE.length())));
        if (includeDigits) password.add(DIGITS.charAt(random.nextInt(DIGITS.length())));
        if (includeSpecial) password.add(SPECIAL_CHARACTERS.charAt(random.nextInt(SPECIAL_CHARACTERS.length())));

        // Добавляем все возможные символы в characterSet
        if (includeLower) characterSet.append(LOWERCASE);
        if (includeUpper) characterSet.append(UPPERCASE);
        if (includeDigits) characterSet.append(DIGITS);
        if (includeSpecial) characterSet.append(SPECIAL_CHARACTERS);

        // Добавляем оставшиеся случайные символы
        for (int i = password.size(); i < length; i++) {
            password.add(characterSet.charAt(random.nextInt(characterSet.length())));
        }

        // Перемешиваем символы
        Collections.shuffle(password, random);

        // Собираем пароль в строку
        StringBuilder result = new StringBuilder();
        for (char c : password) {
            result.append(c);
        }

        return result.toString();
    }
}
